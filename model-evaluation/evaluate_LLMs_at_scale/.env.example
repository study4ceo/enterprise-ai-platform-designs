# API Keys (GROQ is recommended for speed and cost!)
GROQ_API_KEY=your_groq_api_key_here              # Primary - Used for metrics & RAG evaluation (REQUIRED)
GEMINI_API_KEY=your_gemini_api_key_here          # Used for analytics chat (optional)
OPENAI_API_KEY=your_openai_api_key_here          # Optional for GPT models
ANTHROPIC_API_KEY=your_anthropic_api_key_here    # Optional for Claude models

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/llm_evaluation

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672/

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_USER=100  # requests per minute
RATE_LIMIT_WINDOW=60     # seconds

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9100

# RAG Evaluator (NEW!)
EMBEDDING_MODEL=all-MiniLM-L6-v2    # Sentence transformer model for embeddings
RAG_CACHE_TTL=3600                   # Cache evaluation results for 1 hour
DEFAULT_RELEVANCE_THRESHOLD=0.3      # Threshold for context relevance
