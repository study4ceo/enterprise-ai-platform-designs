# SLM Platform Configuration

# ========== Database ==========
DATABASE_URL=postgresql+asyncpg://slm_user:slm_password@postgres:5432/slm_platform

# ========== Redis ==========
REDIS_URL=redis://redis:6379

# ========== MinIO (Object Storage) ==========
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=slm-models

# ========== Paths ==========
MODELS_DIR=/models
DATASETS_DIR=/datasets
CHECKPOINTS_DIR=/checkpoints

# ========== HuggingFace ==========
# Optional: Set if you want to download private models
# HUGGINGFACE_TOKEN=your_hf_token_here

# ========== Training Configuration ==========
# Default training settings
DEFAULT_LEARNING_RATE=2e-4
DEFAULT_BATCH_SIZE=4
DEFAULT_NUM_EPOCHS=3
DEFAULT_MAX_SEQ_LENGTH=2048

# LoRA defaults
DEFAULT_LORA_RANK=16
DEFAULT_LORA_ALPHA=32
DEFAULT_LORA_DROPOUT=0.05

# ========== Resource Limits ==========
MAX_CONCURRENT_TRAININGS=1
MAX_GPU_MEMORY_FRACTION=0.9
ENABLE_GRADIENT_CHECKPOINTING=true

# ========== API Configuration ==========
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ========== Logging ==========
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_TENSORBOARD=true

# ========== Frontend ==========
NEXT_PUBLIC_API_URL=http://localhost:8000

# ========== Monitoring (Optional) ==========
ENABLE_METRICS=true
METRICS_PORT=9090
WANDB_API_KEY=  # Optional: Weights & Biases integration

# ========== Model Defaults ==========
# Which model to use if not specified
DEFAULT_MODEL=mistral-7b

# Inference settings
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=512
DEFAULT_TOP_P=0.9

# ========== Security ==========
# JWT secret for API authentication (generate a strong random string)
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# API rate limiting
RATE_LIMIT_PER_MINUTE=60

# ========== Development ==========
DEBUG=false
RELOAD=true  # Auto-reload on code changes (development only)

# ========== GPU Configuration ==========
CUDA_VISIBLE_DEVICES=0  # Which GPU(s) to use (0,1,2 for multiple)
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# ========== Quantization Defaults ==========
ENABLE_QLORA=true
LOAD_IN_4BIT=false  # Set to true for 4-bit quantization
LOAD_IN_8BIT=false  # Set to true for 8-bit quantization

# ========== Optimization ==========
USE_FLASH_ATTENTION=true  # If available
ENABLE_CPU_OFFLOAD=false  # For very large models
USE_BETTER_TRANSFORMER=true

# ========== Experiment Tracking ==========
TRACK_EXPERIMENTS=true
EXPERIMENT_BACKEND=tensorboard  # tensorboard, wandb, mlflow

# ========== Notifications (Optional) ==========
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# EMAIL_NOTIFICATIONS=false
