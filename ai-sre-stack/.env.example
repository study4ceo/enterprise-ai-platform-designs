# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Kubernetes
KUBECONFIG_PATH=/path/to/kubeconfig
K8S_NAMESPACE=default

# AWS
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Terraform
TERRAFORM_WORKSPACE=/path/to/terraform
TERRAFORM_STATE_BUCKET=your_state_bucket

# Datadog
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key
DATADOG_SITE=datadoghq.com

# PagerDuty
PAGERDUTY_API_KEY=your_pagerduty_api_key
PAGERDUTY_SERVICE_ID=your_service_id

# GitHub
GITHUB_TOKEN=your_github_token
GITHUB_ORG=your_org
GITHUB_REPO=your_repo

# Argo CD
ARGOCD_SERVER=argocd.example.com
ARGOCD_TOKEN=your_argocd_token

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL=#incidents

# Runbook Configuration
RUNBOOK_PATH=./runbooks

# AWS GuardDuty (Security Threat Detection)
# Uses same AWS credentials as AWS MCP
# GuardDuty must be enabled in your AWS account first

# AWS CloudTrail (Audit Logging)
# Uses same AWS credentials as AWS MCP
CLOUDTRAIL_TRAIL_NAME=your_trail_name_optional

# HashiCorp Vault (Secrets Management)
VAULT_URL=http://localhost:8200
VAULT_TOKEN=your_vault_token
VAULT_MOUNT_POINT=secret

# ========================================
# SECURITY CONTROLS CONFIGURATION
# ========================================

# Action Whitelisting
# Controls which actions can be executed
# Default: Enabled (recommended)
SECURITY_ENABLE_ACTION_WHITELIST=true

# Rate Limiting / Throttling
# Prevents runaway automation
# Default: Enabled (recommended)
SECURITY_ENABLE_RATE_LIMITING=true
SECURITY_MAX_ACTIONS_PER_MINUTE=10
SECURITY_MAX_ACTIONS_PER_HOUR=100
SECURITY_MAX_ACTIONS_PER_DAY=500

# Audit Logging
# Comprehensive logging for compliance
# Default: Enabled (recommended)
SECURITY_ENABLE_AUDIT_LOGGING=true
SECURITY_AUDIT_LOG_PATH=./logs/audit.jsonl
SECURITY_MASK_SENSITIVE=true

# Approval Workflow
# Requires approval for high-risk actions
# Default: Enabled (recommended)
SECURITY_ENABLE_APPROVAL_WORKFLOW=true
SECURITY_REQUIRE_APPROVAL_FOR_HIGH_RISK=true
SECURITY_REQUIRE_APPROVAL_FOR_CRITICAL=true
SECURITY_AUTO_APPROVE_LOW_SEVERITY=true
