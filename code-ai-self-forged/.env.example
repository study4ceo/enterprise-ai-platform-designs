# LLM Provider (anthropic or ollama)
LLM_PROVIDER=anthropic

# Anthropic API Configuration (Cloud Mode)
ANTHROPIC_API_KEY=your_api_key_here

# Model Configuration
# Balanced: claude-sonnet-4.6 (recommended)
# Max Power: claude-opus-4.7 (heavyweight, best quality)
MODEL_NAME=claude-sonnet-4.6

# Common Settings
MAX_TOKENS=8000
TEMPERATURE=0.7

# Execution Configuration
EXECUTION_TIMEOUT=30
MAX_RETRIES=3
ENABLE_DOCKER=false

# Logging
LOG_LEVEL=INFO
