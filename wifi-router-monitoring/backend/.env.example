# Database Configuration
DATABASE_URL=postgresql+asyncpg://wifi_user:changeme@localhost:5432/wifi_monitor

# Application Configuration
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-here-change-in-production
SESSION_TIMEOUT_MINUTES=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# HTTPS Configuration (optional)
HTTPS_ENABLED=false
SSL_CERT_FILE=
SSL_KEY_FILE=

# Router Scanning
DEFAULT_SCAN_INTERVAL_SECONDS=30

# Notification Settings
BROWSER_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=false
WEBHOOK_NOTIFICATIONS_ENABLED=false

# Email Configuration (if EMAIL_NOTIFICATIONS_ENABLED=true)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=WiFi Monitor <noreply@example.com>
EMAIL_RECIPIENTS=admin@example.com

# Webhook Configuration (if WEBHOOK_NOTIFICATIONS_ENABLED=true)
WEBHOOK_URLS=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Data Retention
CONNECTION_HISTORY_RETENTION_DAYS=90

# Performance
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
